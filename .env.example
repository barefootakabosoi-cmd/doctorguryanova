# === GigaChat API (ИИ-маркетинг) ===
# Получить: https://developers.sber.ru → Создать проект → GigaChat API
# Scope для физлиц: GIGACHAT_API_PERS
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# === GigaChat API (ИИ-контент + маркетинг) ===
# Получить: https://developers.sber.ru
# Scope: GIGACHAT_API_PERS (физлицо, 365M токенов/год бесплатно)
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# === Яндекс.Метрика (аналитика для ИИ-агента) ===
# Получить: https://oauth.yandex.ru
YANDEX_METRIKA_TOKEN=
YANDEX_METRIKA_COUNTER_ID=

# === Яндекс.Директ (реклама, ручной запуск) ===
